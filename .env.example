# HiddenYatra — Local Development Environment Configuration Template
# Instructions: Copy this file to '.env' and fill in your local MySQL database credentials.
# DO NOT commit or push '.env' to version control!

# Flask Application Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-change-in-production-use-strong-random-key

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hiddenyatra
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Database Pool Settings
DB_CHARSET=utf8mb4
DB_POOL_SIZE=5
DB_POOL_MAX=20
DB_TIMEOUT=10

# Optional Email / SMTP Settings (for OTP email sending in dev)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# Google Maps Platform (Phase G1+)
# Get your API key: https://console.cloud.google.com/apis/credentials
# Create a Map ID: https://console.cloud.google.com/google/maps-apis/studio/map-ids
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=
MAP_ENGINE=leaflet
